AI_MODE=live
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Total deadline is capped at 12s to fit the current frontend's 15s timeout.
AI_TIMEOUT_SECONDS=12
AI_REQUEST_TIMEOUT_SECONDS=12
AI_CACHE_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Reserved for the persistence stage; not used by the stateless skeleton.
DATABASE_URL=sqlite:///./city.db
