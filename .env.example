# live: provider or verified demo cache; without a key, a clearly labelled template.
# mock: template only, no paid calls. Never commit your local .env.
AI_MODE=live
OPENAI_API_KEY=
# Required in live mode; no hidden model default in application code.
# This fast non-reasoning model does not accept reasoning_effort.
OPENAI_MODEL=gpt-4.1-mini
# Total deadline <=30s; frontend waits 35s. One SDK retry fits inside the deadline.
AI_TIMEOUT_SECONDS=30
AI_REQUEST_TIMEOUT_SECONDS=25
AI_CACHE_ENABLED=true
# Empty uses ai/demo_cache.json. Warm it with python -m scripts.warm_demo.
AI_DEMO_CACHE_PATH=
# Exact UI origins only. Empty for same-origin production; never use *.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local combined application port; Docker container uses 8000.
PORT=8001
